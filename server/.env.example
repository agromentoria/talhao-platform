# Copie este arquivo para ".env" e ajuste os valores antes de publicar.

# Porta em que a API vai rodar
PORT=4000

# String de conexão do banco Postgres. Recomendação para começar sem custo:
# crie um banco gratuito em https://neon.tech (não pede cartão) e cole
# aqui a "Connection string" que ele fornece, algo como:
# postgresql://usuario:senha@ep-exemplo.sa-east-1.aws.neon.tech/talhao?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Segredo usado para assinar os tokens de login (JWT).
# Gere um valor forte e único, por exemplo com: openssl rand -hex 32
JWT_SECRET=troque-este-valor-por-uma-chave-secreta-forte

# Por quanto tempo o login do usuário fica válido
JWT_EXPIRES_IN=7d

# Comissão da plataforma (Talhão) sobre o lucro de cada colheita, em %
APP_COMMISSION_PCT=5

# Endereço do site/app que vai consumir esta API (para liberar o CORS).
# Em produção, coloque o domínio real, ex: https://app.meutalhao.com.br
CLIENT_ORIGIN=http://localhost:5173

# Dados do primeiro usuário administrador (mediador da plataforma),
# criado automaticamente na primeira vez que o servidor rodar.
ADMIN_NAME=Administrador Talhão
ADMIN_EMAIL=admin@meutalhao.com.br
ADMIN_PASSWORD=troque-esta-senha-no-primeiro-acesso
